# =============================================================================
# XAU/USD Trading System - Environment Variables
# Copy this to .env and fill in your credentials
# WARNING: .env is NEVER committed to git
# =============================================================================

# MT5 Account
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Server

# News API (Trading Economics / Forex Factory / Finnhub)
NEWS_API_KEY=your_api_key_here

# Telegram Bot (for alerts & monitoring)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# PostgreSQL (optional - falls back to SQLite if not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xau_trading
DB_USER=postgres
DB_PASSWORD=your_db_password_here
